# Browser Configuration
# Set to true for background scraping, false to watch the browser in action
HEADLESS=false

# Multi-proxy configuration (primary, fallback1, fallback2)
PROXY_ACCOUNT_SLUGS=brightdata-residential,oxylabs-residential,brightdata-datacenter

# Backward compatibility for buildProxy() - use first proxy as default
PROXY_ACCOUNT_SLUG=brightdata-residential

# Optional: Proxy region (e.g., us, br, es)
PROXY_REGION=
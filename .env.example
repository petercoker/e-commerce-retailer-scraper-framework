# Browser Configuration
# Set to true for background scraping, false to watch the browser in action
HEADLESS=false

# Proxy Configuration
# The proxy account slug (e.g., brightdata-datacenter, oxylabs-ecommerce-scraper-api-amazon-not-rendered)
# Required for connecting to proxy providers
PROXY_ACCOUNT_SLUG=your-proxy-account-slug

# Optional: Proxy region (e.g., us, br, es)
# Leave empty or omit to use proxy without region specification
PROXY_REGION=